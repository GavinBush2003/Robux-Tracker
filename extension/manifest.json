{
  "manifest_version": 3,
  "name": "Robux Tracker — see where your Robux went",
  "short_name": "RobuxTracker",
  "version": "6.0.0",
  "description": "See where your Robux went — your own purchase history, broken down per game and per item, in your currency. Unofficial.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://web.roblox.com/*"
      ],
      "js": [
        "robux-tracker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://economy.roblox.com/*",
    "https://users.roblox.com/*",
    "https://apis.roblox.com/*",
    "https://thumbnails.roblox.com/*"
  ]
}
